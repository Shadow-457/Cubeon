{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/doctor.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "^/403$",
      "dest": "/403.html",
      "status": 403
    },
    {
      "src": "^/429$",
      "dest": "/429.html",
      "status": 429
    },
    {
      "src": "^/500$",
      "dest": "/500.html",
      "status": 500
    },
    {
      "src": "^/502$",
      "dest": "/502.html",
      "status": 502
    },
    {
      "src": "^/503$",
      "dest": "/503.html",
      "status": 503
    },
    {
      "src": "^/404$",
      "dest": "/404.html",
      "status": 404
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ylet.online"
        }
      ],
      "destination": "https://www.ylet.online/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "cubeon.ylet.online"
        }
      ],
      "destination": "https://www.ylet.online/:path*",
      "permanent": true
    },
    {
      "source": "/linuxdownload",
      "destination": "https://cubeon-downloads.hamza-457-shahbaz.workers.dev/linuxdownload",
      "permanent": false
    },
    {
      "source": "/linuxdeb",
      "destination": "https://cubeon-downloads.hamza-457-shahbaz.workers.dev/linuxdeb",
      "permanent": false
    },
    {
      "source": "/linuxsetup",
      "destination": "https://cubeon-downloads.hamza-457-shahbaz.workers.dev/linuxsetup",
      "permanent": false
    },
    {
      "source": "/linuxinstaller",
      "destination": "https://cubeon-downloads.hamza-457-shahbaz.workers.dev/linuxinstaller",
      "permanent": false
    },
    {
      "source": "/windowsdownload",
      "destination": "https://cubeon-downloads.hamza-457-shahbaz.workers.dev/windowsdownload",
      "permanent": false
    },
    {
      "source": "/cubeon-bench/workspace",
      "destination": "/cubeon-bench",
      "permanent": false
    },
    {
      "source": "/cubeon-bench/workspace.html",
      "destination": "/cubeon-bench",
      "permanent": false
    },
    {
      "source": "/cubeon-bench/landing",
      "destination": "/cubeon-bench",
      "permanent": false
    },
    {
      "source": "/cubeon-bench/landing.html",
      "destination": "/cubeon-bench",
      "permanent": false
    },
    {
      "source": "/cubeon-bench/index",
      "destination": "/cubeon-bench",
      "permanent": false
    },
    {
      "source": "/cubeon-bench/index.html",
      "destination": "/cubeon-bench",
      "permanent": false
    },
    {
      "source": "/ar",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ar/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ar/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ar/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/ru",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ru/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ru/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ru/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/uk",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/uk/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/uk/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/uk/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ]
}
