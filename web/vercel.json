{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/doctor.js": {
      "maxDuration": 60
    },
    "api/retired.js": {
      "includeFiles": "404.html"
    },
    "api/status.js": {
      "includeFiles": "*.html"
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ylet.online"
        }
      ],
      "destination": "https://www.ylet.online/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "cubeon.ylet.online"
        }
      ],
      "destination": "https://www.ylet.online/:path*",
      "permanent": true
    },
    {
      "source": "/linuxdownload",
      "destination": "https://cubeon-downloads.hamza-457-shahbaz.workers.dev/linuxdownload",
      "permanent": false
    },
    {
      "source": "/linuxdeb",
      "destination": "https://cubeon-downloads.hamza-457-shahbaz.workers.dev/linuxdeb",
      "permanent": false
    },
    {
      "source": "/linuxsetup",
      "destination": "https://cubeon-downloads.hamza-457-shahbaz.workers.dev/linuxsetup",
      "permanent": false
    },
    {
      "source": "/linuxinstaller",
      "destination": "https://cubeon-downloads.hamza-457-shahbaz.workers.dev/linuxinstaller",
      "permanent": false
    },
    {
      "source": "/macosarm64download",
      "destination": "https://cubeon-downloads.hamza-457-shahbaz.workers.dev/macosarm64download",
      "permanent": false
    },
    {
      "source": "/macosx64download",
      "destination": "https://cubeon-downloads.hamza-457-shahbaz.workers.dev/macosx64download",
      "permanent": false
    },
    {
      "source": "/windowsdownload",
      "destination": "https://cubeon-downloads.hamza-457-shahbaz.workers.dev/windowsdownload",
      "permanent": false
    },
    {
      "source": "/ar",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ar/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ar/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ar/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/ru",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ru/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ru/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ru/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/uk",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/uk/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/uk/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/uk/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/cubeon-bench",
      "destination": "/api/retired"
    },
    {
      "source": "/cubeon-bench.html",
      "destination": "/api/retired"
    },
    {
      "source": "/cubeon-bench/:path*",
      "destination": "/api/retired"
    },
    {
      "source": "/403",
      "destination": "/api/status?code=403"
    },
    {
      "source": "/404",
      "destination": "/api/status?code=404"
    },
    {
      "source": "/429",
      "destination": "/api/status?code=429"
    },
    {
      "source": "/500",
      "destination": "/api/status?code=500"
    },
    {
      "source": "/502",
      "destination": "/api/status?code=502"
    },
    {
      "source": "/503",
      "destination": "/api/status?code=503"
    }
  ]
}
