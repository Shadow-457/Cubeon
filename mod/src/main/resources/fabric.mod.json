{
  "schemaVersion": 1,
  "id": "cubeon-client",
  "version": "${version}",
  "name": "Cubeon Client",
  "description": "The Cubeon Client: marks Cubeon players in Minecraft's player list, keeps the offline session working, and adds the Cubeon Client overlays (FPS, keystrokes, armour durability, ping, CPS - press K). Powered by the Cubeon launcher running on this machine.",
  "authors": ["Cubeon"],
  "license": "MIT",
  "icon": "assets/cubeon-client/icon.png",
  "environment": "${environment}",
  "entrypoints": {
    "main": [${emotes_main}],
    "client": [
      "com.cubeon.client.CubeonClient",
      "com.cubeon.client.hud.CubeonHudClient"${emotes_entrypoint}
    ]
  },
  "mixins": [
    {
      "config": "cubeon-client.mixins.json",
      "environment": "client"
    }${mixins_extra}${zoom_mixins}${emotes_mixins}
  ],
  "depends": {
    "minecraft": "${minecraft_range}",
    "fabricloader": ">=${loader_range}",
    "java": "${java_range}"
  },
  "recommends": {
    "fabric-api": "*"
  }
}
