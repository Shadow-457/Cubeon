{
  "schemaVersion": 1,
  "id": "cubeon-client",
  "version": "${version}",
  "name": "Cubeon Client",
  "description": "The Cubeon Client: marks Cubeon players in Minecraft's player list and keeps the offline session working. Powered by the Cubeon launcher running on this machine.",
  "authors": ["Cubeon"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.cubeon.client.CubeonClient"]
  },
  "mixins": [
    {
      "config": "cubeon-client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "minecraft": "${minecraft_range}",
    "fabricloader": ">=${loader_range}",
    "java": ">=17"
  }
}
