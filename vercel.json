{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/doctor.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ylet.online"
        }
      ],
      "destination": "https://www.ylet.online/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "cubeon.ylet.online"
        }
      ],
      "destination": "https://www.ylet.online/:path*",
      "permanent": true
    },
    {
      "source": "/linuxdownload",
      "destination": "https://cubeon-downloads.hamza-457-shahbaz.workers.dev/linuxdownload",
      "permanent": false
    },
    {
      "source": "/linuxdeb",
      "destination": "https://cubeon-downloads.hamza-457-shahbaz.workers.dev/linuxdeb",
      "permanent": false
    },
    {
      "source": "/linuxsetup",
      "destination": "https://cubeon-downloads.hamza-457-shahbaz.workers.dev/linuxsetup",
      "permanent": false
    },
    {
      "source": "/linuxinstaller",
      "destination": "https://cubeon-downloads.hamza-457-shahbaz.workers.dev/linuxinstaller",
      "permanent": false
    },
    {
      "source": "/windowsdownload",
      "destination": "https://cubeon-downloads.hamza-457-shahbaz.workers.dev/windowsdownload",
      "permanent": false
    },
    {
      "source": "/cubeon-bench/workspace",
      "destination": "/cubeon-bench",
      "permanent": false
    },
    {
      "source": "/cubeon-bench/workspace.html",
      "destination": "/cubeon-bench",
      "permanent": false
    },
    {
      "source": "/cubeon-bench/landing",
      "destination": "/cubeon-bench",
      "permanent": false
    },
    {
      "source": "/cubeon-bench/landing.html",
      "destination": "/cubeon-bench",
      "permanent": false
    },
    {
      "source": "/cubeon-bench/index",
      "destination": "/cubeon-bench",
      "permanent": false
    },
    {
      "source": "/cubeon-bench/index.html",
      "destination": "/cubeon-bench",
      "permanent": false
    },
    {
      "source": "/ar",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ar/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ar/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ar/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/ru",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ru/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ru/index.html",
      "destination": "/",
      "permanent": true
